{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:selfreviewrecord",
  "$defs": {
    "SelfReviewRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "governed_content_root",
        "repo0_receipt_sha256",
        "candidate_qualification_sha256",
        "task_manifest_sha256",
        "command_result_root",
        "checks",
        "authority_granted"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "governed_content_root": {
          "type": "string",
          "minLength": 1
        },
        "repo0_receipt_sha256": {
          "type": "string",
          "minLength": 1
        },
        "candidate_qualification_sha256": {
          "type": "string",
          "minLength": 1
        },
        "task_manifest_sha256": {
          "type": "string",
          "minLength": 1
        },
        "command_result_root": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "authority_granted": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    },
    "PlanSelfReviewRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "governed_content_root",
        "task_manifest_sha256",
        "checks",
        "test_exit_code",
        "test_output_sha256",
        "independent_plan_review",
        "runtime_implementation_ready",
        "authorized_production_phases"
      ],
      "properties": {
        "schema_version": {
          "const": "plan-self-review/v1"
        },
        "governed_content_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checks": {
          "type": "object"
        },
        "test_exit_code": {
          "const": 0
        },
        "test_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_plan_review": {
          "const": "PENDING"
        },
        "runtime_implementation_ready": {
          "const": "NO"
        },
        "authorized_production_phases": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    }
  }
}
