{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:proof-coverage",
  "$defs": {
    "ProofCoverageMatrix": {
      "type": "object",
      "required": [
        "schema_version",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "const": "proof-coverage/v1"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "requirement_id",
              "source_finding",
              "implementation_symbol",
              "test_file",
              "vector_ids",
              "command_id",
              "evidence_artifact",
              "release_gate",
              "stage",
              "evidence_owner",
              "verification_kind",
              "sealed_evidence_path"
            ],
            "properties": {
              "requirement_id": {
                "type": "string"
              },
              "source_finding": {
                "type": "string"
              },
              "implementation_symbol": {
                "type": "string"
              },
              "test_file": {
                "type": "string"
              },
              "vector_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "command_id": {
                "type": "string"
              },
              "evidence_artifact": {
                "type": "string"
              },
              "release_gate": {
                "type": "string"
              },
              "stage": {
                "enum": [
                  "CANDIDATE",
                  "SEALED",
                  "REVIEWED"
                ]
              },
              "evidence_owner": {
                "type": "string"
              },
              "verification_kind": {
                "const": "EXECUTED_RUNTIME_EVIDENCE"
              },
              "sealed_evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
