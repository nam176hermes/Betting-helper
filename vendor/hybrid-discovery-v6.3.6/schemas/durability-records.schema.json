      "properties": {
        "record_type": {
          "const": "SpoolRecord"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "guarantee": {
          "$ref": "#/$defs/Guarantee"
        },
        "spool_record_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "raw_observation_id": {
          "$ref": "#/$defs/RawObservationId"
        },
        "raw_observation_content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "previous_cursor_hash": {
          "$ref": "#/$defs/Hash"
        },
        "cursor_hash": {
          "$ref": "#/$defs/Hash"
        },
        "cursor_hash_verification": {
          "const": "VERIFIED_HD_CURSOR_STEP_V1"
        },
        "spool_state": {
          "enum": [
            "VALIDATED",
            "DURABLY_SPOOLED",
            "ACK_VERIFIED",
            "RETAINED_UNTIL_WHOLE_RUN_DESTRUCTION"
          ]
        },
        "committed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "payload_size_bytes": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "individual_deletion_eligible": {
          "const": false
        }
      }
    },
