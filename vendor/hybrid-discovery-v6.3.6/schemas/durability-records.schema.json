{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-discovery.local/schemas/v6.2/durability-records.schema.json",
  "title": "Hybrid Discovery v6.2 durability records",
  "description": "Closed immutable durability records. Cross-record rules in $defs.SemanticInvariants are mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/SpoolRecord"
    },
    {
      "$ref": "#/$defs/RawCommitRecord"
    },
    {
      "$ref": "#/$defs/ApplicationRecord"
    },
    {
      "$ref": "#/$defs/DerivedRevision"
    },
    {
      "$ref": "#/$defs/ReducerCursor"
    },
    {
      "$ref": "#/$defs/AckOutboxRecord"
    },
    {
      "$ref": "#/$defs/AckCursor"
    },
    {
      "$ref": "#/$defs/GapRecord"
    },
    {
      "$ref": "#/$defs/GenerationTransition"
    },
    {
      "$ref": "#/$defs/RunDestructionIntent"
    },
    {
      "$ref": "#/$defs/DeletionProof"
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "1"
    },
    "Guarantee": {
      "type": "string",
      "const": "EFFECTIVELY_ONCE_AFTER_DURABLE_LOCAL_SPOOL_COMMIT"
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*:[0-9a-f]{64}$"
    },
    "RawObservationId": {
      "type": "string",
      "pattern": "^observation:[0-9a-f]{64}$"
    },
    "UnsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "StreamKey": {
      "$anchor": "StreamKey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_run_id",
        "producer_id",
        "stream_id"
      ],
      "properties": {
        "browser_run_id": {
          "$ref": "#/$defs/Uuid"
        },
        "producer_id": {
          "$ref": "#/$defs/Uuid"
        },
        "stream_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "GenerationKey": {
      "$anchor": "GenerationKey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream",
        "generation"
      ],
      "properties": {
        "stream": {
          "$ref": "#/$defs/StreamKey"
        },
        "generation": {
          "$ref": "#/$defs/UnsignedDecimal"
        }
      }
    },
    "Position": {
      "$anchor": "Position",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_key",
        "sequence"
      ],
      "properties": {
        "generation_key": {
          "$ref": "#/$defs/GenerationKey"
        },
        "sequence": {
          "$ref": "#/$defs/PositiveDecimal"
        }
      }
    },
    "CursorChainContract": {
      "$anchor": "CursorChainContract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_domain",
        "step_domain",
        "seed_hash_h0",
        "first_step_hash_h1",
        "step_input"
      ],
      "properties": {
        "seed_domain": {
          "const": "HYBRID-DISCOVERY/v6.2/CursorSeed/v1\u0000"
        },
        "step_domain": {
          "const": "HYBRID-DISCOVERY/v6.2/CursorStep/v1\u0000"
        },
        "seed_hash_h0": {
          "const": "149300a0e3954885a1d6c0f13a9d1101227cc21cce37bd6b7c72eab641741c0c"
        },
        "first_step_hash_h1": {
          "const": "739669d828057e94c856e7725ed05218e26639610d4ce58c2a5568244a16fc28"
        },
        "step_input": {
          "const": "PREVIOUS_CURSOR_HASH_AND_FULL_RAW_OBSERVATION_CONTENT_HASH"
        }
      }
    },
    "SpoolRecord": {
      "$anchor": "SpoolRecord",
      "type": "object",
      "additionalProperties": false,
