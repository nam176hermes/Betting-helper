{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybrid-discovery.local/schemas/v6.2/clock-coherence-records.schema.json",
  "title": "Hybrid Discovery v6.2 clock and coherence records",
  "description": "Closed immutable clock observations, mappings, closures, shocks, freshness vectors, coherence epochs, transitions, and resnapshot proofs.",
  "oneOf": [
    {
      "$ref": "#/$defs/BrowserClockObservation"
    },
    {
      "$ref": "#/$defs/DocumentClockObservation"
    },
    {
      "$ref": "#/$defs/CdpClockObservation"
    },
    {
      "$ref": "#/$defs/RelayClockObservation"
    },
    {
      "$ref": "#/$defs/BackendClockObservation"
    },
    {
      "$ref": "#/$defs/ClockMapping"
    },
    {
      "$ref": "#/$defs/ClockMappingClosure"
    },
    {
      "$ref": "#/$defs/InputFreshnessVector"
    },
    {
      "$ref": "#/$defs/ShockObservation"
    },
    {
      "$ref": "#/$defs/FixtureCoherenceEpoch"
    },
    {
      "$ref": "#/$defs/CoherenceTransition"
    },
    {
      "$ref": "#/$defs/AuthoritativeResnapshotProof"
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "1"
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*:[0-9a-f]{64}$"
    },
    "UnsignedDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "SignedDecimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ClockUnit": {
      "const": "MICROSECOND"
    },
    "ObservationOwner": {
      "enum": [
        "EXTENSION_SERVICE_WORKER",
        "TARGET_DOCUMENT",
        "CDP_BROWSER",
        "RELAY_PROCESS",
        "BACKEND_PROCESS"
      ]
    },
    "BrowserClockObservation": {
      "$anchor": "BrowserClockObservation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "observation_id",
        "clock_domain_id",
        "boot_id",
        "unit",
        "monotonic_value",
        "resolution_us",
        "owner",
        "conversion_rule",
        "observed_at_utc",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "BrowserClockObservation"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "observation_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "const": "EXTENSION_SERVICE_WORKER"
        },
        "conversion_rule": {
          "const": "FLOOR_JAVASCRIPT_MILLISECONDS_TIMES_1000"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "DocumentClockObservation": {
      "$anchor": "DocumentClockObservation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
