          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "const": "TARGET_DOCUMENT"
        },
        "conversion_rule": {
          "const": "FLOOR_JAVASCRIPT_MILLISECONDS_TIMES_1000"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "CdpClockObservation": {
      "$anchor": "CdpClockObservation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "observation_id",
        "cdp_session_generation",
        "clock_domain_id",
        "boot_id",
        "unit",
        "monotonic_value",
        "resolution_us",
        "owner",
        "mapping_status",
        "observed_at_utc",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "CdpClockObservation"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "observation_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "cdp_session_generation": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "const": "CDP_BROWSER"
        },
        "mapping_status": {
          "enum": [
            "MAPPED",
            "UNKNOWN"
          ]
        },
        "observed_at_utc": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "RelayClockObservation": {
      "$anchor": "RelayClockObservation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "observation_id",
        "clock_domain_id",
        "boot_id",
        "unit",
        "monotonic_value",
        "resolution_us",
        "owner",
        "conversion_rule",
        "observed_at_utc",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "RelayClockObservation"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "observation_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "const": "RELAY_PROCESS"
        },
        "conversion_rule": {
          "enum": [
            "FLOOR_JAVASCRIPT_MILLISECONDS_TIMES_1000",
            "PYTHON_MONOTONIC_NS_INTEGER_DIVIDE_1000"
          ]
        },
        "observed_at_utc": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "BackendClockObservation": {
      "$anchor": "BackendClockObservation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "observation_id",
        "clock_domain_id",
        "boot_id",
        "unit",
        "monotonic_value",
        "resolution_us",
        "owner",
        "conversion_rule",
        "observed_at_utc",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "BackendClockObservation"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "observation_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "const": "BACKEND_PROCESS"
        },
        "conversion_rule": {
          "const": "PYTHON_MONOTONIC_NS_INTEGER_DIVIDE_1000"
        },
        "observed_at_utc": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "TimestampEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_domain_id",
        "boot_id",
        "unit",
        "monotonic_value",
        "resolution_us",
        "owner"
      ],
      "properties": {
        "clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "monotonic_value": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "resolution_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "owner": {
          "$ref": "#/$defs/ObservationOwner"
        }
      }
    },
    "FourTimestampSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "t1",
        "t2",
        "t3",
        "t4",
        "t1_owner",
        "t2_owner",
        "t3_owner",
        "t4_owner",
        "offset_sign",
        "network_rtt_us",
        "raw_lower_us",
        "raw_upper_us",
        "padding_us",
        "offset_lower_us",
        "offset_upper_us",
        "offset_midpoint_us",
        "base_uncertainty_us"
      ],
      "properties": {
        "sample_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "t1": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "t2": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "t3": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "t4": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "t1_owner": {
          "const": "SOURCE_IMMEDIATELY_BEFORE_PING"
        },
        "t2_owner": {
          "const": "TARGET_IMMEDIATELY_AFTER_AUTHENTICATED_RECEIPT"
        },
        "t3_owner": {
          "const": "TARGET_IMMEDIATELY_BEFORE_PONG"
        },
        "t4_owner": {
          "const": "SOURCE_IMMEDIATELY_AFTER_AUTHENTICATED_VALIDATION"
        },
        "offset_sign": {
          "const": "THETA_EQUALS_TARGET_CLOCK_MINUS_SOURCE_CLOCK"
        },
        "network_rtt_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "raw_lower_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "raw_upper_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "padding_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "offset_lower_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "offset_upper_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "offset_midpoint_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "base_uncertainty_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        }
      }
    },
    "GuardrailConstants": {
      "$anchor": "GuardrailConstants",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_period_us",
        "sample_window_count",
        "minimum_valid_samples",
        "max_network_rtt_us",
        "max_base_uncertainty_us",
        "relative_drift_ppm",
        "max_mapping_segment_age_us",
        "wall_step_tolerance_us"
      ],
      "properties": {
        "sample_period_us": {
          "const": "1000000"
        },
        "sample_window_count": {
          "const": "32"
        },
        "minimum_valid_samples": {
          "const": "8"
        },
        "max_network_rtt_us": {
          "const": "250000"
        },
        "max_base_uncertainty_us": {
          "const": "125000"
        },
        "relative_drift_ppm": {
          "const": "100"
        },
        "max_mapping_segment_age_us": {
          "const": "30000000"
        },
        "wall_step_tolerance_us": {
          "const": "1000000"
        }
      }
    },
    "ClockMapping": {
      "$anchor": "ClockMapping",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "clock_mapping_id",
        "source_clock_domain_id",
        "source_boot_id",
        "source_owner",
        "target_clock_domain_id",
        "target_boot_id",
        "target_owner",
        "unit",
        "samples",
        "source_anchor_us",
        "offset_lower_us",
        "offset_upper_us",
        "offset_midpoint_us",
        "base_uncertainty_us",
        "network_rtt_us",
        "drift_formula",
        "valid_from_source_us",
        "valid_until_source_us",
        "status",
        "guardrails",
        "selection_rule",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "ClockMapping"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "clock_mapping_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "source_clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "source_boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "source_owner": {
          "$ref": "#/$defs/ObservationOwner"
        },
        "target_clock_domain_id": {
          "$ref": "#/$defs/Uuid"
        },
        "target_boot_id": {
          "$ref": "#/$defs/Uuid"
        },
        "target_owner": {
          "$ref": "#/$defs/ObservationOwner"
        },
        "unit": {
          "$ref": "#/$defs/ClockUnit"
        },
        "samples": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/FourTimestampSample"
          }
        },
        "source_anchor_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "offset_lower_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "offset_upper_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "offset_midpoint_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "base_uncertainty_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "network_rtt_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "drift_formula": {
          "const": "CEIL(100*ABS(X-SOURCE_ANCHOR_US)/1000000)"
        },
        "valid_from_source_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "valid_until_source_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "status": {
          "const": "OPEN"
        },
        "guardrails": {
          "$ref": "#/$defs/GuardrailConstants"
        },
        "selection_rule": {
          "const": "MATCH_DOMAIN_BOOT_UNIT_AND_OPEN_VALIDITY_THEN_MIN_INTERVAL_WIDTH_THEN_LATEST_VALIDITY_START_THEN_LEXICOGRAPHIC_MAPPING_ID"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "ClockMappingClosure": {
      "$anchor": "ClockMappingClosure",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "clock_mapping_closure_id",
        "clock_mapping_id",
        "closure_reason",
        "closed_at",
        "permanent",
        "reopen_permitted",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "ClockMappingClosure"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "clock_mapping_closure_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "clock_mapping_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "closure_reason": {
          "enum": [
            "DOMAIN_BOOT_CHANGED",
            "MONOTONIC_REGRESSION",
            "WALL_CLOCK_STEP",
            "SLEEP_RESUME",
            "MAX_DURATION",
            "RTT_EXCEEDED",
            "UNCERTAINTY_EXCEEDED",
            "INCONSISTENT_MAPPING",
            "LIFECYCLE_INVALIDATED",
            "RUN_CLOSED"
          ]
        },
        "closed_at": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "permanent": {
          "const": true
        },
        "reopen_permitted": {
          "const": false
        },
        "immutable": {
          "const": true
        }
      }
    },
    "RequiredInputFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "observation_id",
        "mapping_id",
        "observation_lower_bound_us",
        "observation_upper_bound_us",
        "decision_lower_bound_us",
        "decision_upper_bound_us",
        "conservative_age_us",
        "ttl_us",
        "status",
        "age_formula"
      ],
      "properties": {
        "requirement": {
          "const": "REQUIRED_INPUT"
        },
        "observation_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "mapping_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "observation_lower_bound_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "observation_upper_bound_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "decision_lower_bound_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "decision_upper_bound_us": {
          "$ref": "#/$defs/SignedDecimal"
        },
        "conservative_age_us": {
          "$ref": "#/$defs/UnsignedDecimal"
        },
        "ttl_us": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "status": {
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        },
        "age_formula": {
          "const": "DECISION_UPPER_BOUND_US_MINUS_OBSERVATION_LOWER_BOUND_US"
        }
      }
    },
    "NotRequiredInputFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "reason"
      ],
      "properties": {
        "requirement": {
          "const": "NOT_REQUIRED_FOR_THIS_DISCOVERY_CHECK"
        },
        "reason": {
          "enum": [
            "OUT_OF_SCOPE",
            "NOT_A_CONSUMER_INPUT",
            "CAPABILITY_NOT_UNDER_TEST"
          ]
        }
      }
    },
    "FreshnessEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/RequiredInputFreshness"
        },
        {
          "$ref": "#/$defs/NotRequiredInputFreshness"
        }
      ]
    },
    "InputFreshnessVector": {
      "$anchor": "InputFreshnessVector",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "content_hash",
        "input_freshness_vector_id",
        "evaluation_clock",
        "FOOTBALL_STATE",
        "OPERATOR_STATE",
        "MARKET_BOOK",
        "DISPLAY_EVIDENCE",
        "BETSLIP_EVIDENCE",
        "POSITION",
        "CASHOUT_OFFER",
        "created_at",
        "immutable"
      ],
      "properties": {
        "record_type": {
          "const": "InputFreshnessVector"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "input_freshness_vector_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluation_clock": {
          "$ref": "#/$defs/TimestampEndpoint"
        },
        "FOOTBALL_STATE": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "OPERATOR_STATE": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "MARKET_BOOK": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "DISPLAY_EVIDENCE": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "BETSLIP_EVIDENCE": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "POSITION": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "CASHOUT_OFFER": {
          "$ref": "#/$defs/FreshnessEntry"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "ShockObservation": {
      "$anchor": "ShockObservation",
