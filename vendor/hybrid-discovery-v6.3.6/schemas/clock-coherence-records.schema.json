              },
              "input_freshness_vector_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "resnapshot_proof_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "candidate_epoch_relation": {
                "const": "DISTINCT_SUCCESSOR"
              },
              "proof_status_at_transition": {
                "const": "OBSERVED"
              },
              "proof_verified": {
                "const": true
              },
              "freshness_binding_verified": {
                "const": true
              },
              "shock_binding_verified": {
                "const": true
              },
              "mapping_bindings_verified": {
                "const": true
              },
              "continuity_bindings_verified": {
                "const": true
              },
              "predecessor_permanently_closed": {
                "const": true
              },
              "release_predicate_at_transition": {
                "const": "SATISFIED"
              },
              "transition_reason": {
                "const": "RESNAPSHOT_CANDIDATE_ACCEPTED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from_state": {
                "const": "NEW_EPOCH_PENDING"
              },
              "transition_reason": {
                "const": "RELEASE_PREDICATE_SATISFIED"
              }
            },
            "required": [
              "from_state",
              "transition_reason"
            ]
          },
          "then": {
            "required": [
              "candidate_epoch_relation",
              "proof_status_at_transition",
              "proof_verified",
              "freshness_binding_verified",
              "shock_binding_verified",
              "mapping_bindings_verified",
              "continuity_bindings_verified",
              "predecessor_permanently_closed",
              "release_predicate_at_transition",
              "proof_bound_mappings_open_unclosed_valid_at_release",
              "freshness_bindings_valid_at_release",
              "continuity_bindings_valid_at_release"
            ],
            "properties": {
              "to_state": {
                "const": "NEW_EPOCH_OPEN"
              },
              "candidate_epoch_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "shock_observation_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "input_freshness_vector_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "resnapshot_proof_id": {
                "$ref": "#/$defs/ArtifactId"
              },
              "candidate_epoch_relation": {
                "const": "DISTINCT_SUCCESSOR"
              },
              "proof_status_at_transition": {
                "const": "OBSERVED"
              },
              "proof_verified": {
                "const": true
              },
              "freshness_binding_verified": {
                "const": true
              },
              "shock_binding_verified": {
                "const": true
              },
              "mapping_bindings_verified": {
                "const": true
              },
              "continuity_bindings_verified": {
                "const": true
              },
              "predecessor_permanently_closed": {
                "const": true
              },
              "release_predicate_at_transition": {
                "const": "SATISFIED"
              },
              "proof_bound_mappings_open_unclosed_valid_at_release": {
                "const": true
              },
              "freshness_bindings_valid_at_release": {
                "const": true
              },
              "continuity_bindings_valid_at_release": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from_state": {
                "const": "NEW_EPOCH_PENDING"
