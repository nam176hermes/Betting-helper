{
  "manifest_version": 3,
  "name": "Betting-helper Read-only Part B",
  "version": "1.0.0",
  "description": "Local read-only display. Models disabled. No transaction controls.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [],
  "web_accessible_resources": [],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; object-src 'none'; form-action 'none'; connect-src ws://127.0.0.1:8765"
  },
  "optional_host_permissions": [
    "https://miseojeuplus.espacejeux.com/*"
  ],
  "background": {
    "service_worker": "src/live/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open read-only panel"
  },
  "side_panel": {
    "default_path": "src/live/panel.html"
  }
}
