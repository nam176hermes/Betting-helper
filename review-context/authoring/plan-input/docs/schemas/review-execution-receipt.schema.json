{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:review-execution-receipt",
  "$defs": {
    "FreshSessionAttestation": {
      "type": "object",
      "required": [
        "attestation_type",
        "attested",
        "attested_by",
        "attested_at",
        "procedural_not_cryptographic"
      ],
      "properties": {
        "attestation_type": {
          "const": "HUMAN_FRESH_CODEX_SESSION"
        },
        "attested": {
          "const": true
        },
        "attested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attested_at": {
          "type": "string",
          "format": "date-time"
        },
        "procedural_not_cryptographic": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "ReviewExecutionReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_id",
        "authorization_id",
        "issuer_role",
        "issuer_key_id",
        "review_role",
        "review_run_id",
        "workspace_root",
        "workspace_attestation_sha256",
        "input_content_roots",
        "result_sha256",
        "commands_executed_root",
        "allowed_changed_paths",
        "unexpected_changed_paths",
        "started_at",
        "finished_at",
        "authorization_consumed_at",
        "fresh_session_attestation",
        "production_authority",
        "signature_algorithm",
        "signature",
        "host_boot_id",
        "trust_epoch",
        "preparation_commands_root"
      ],
      "properties": {
        "schema_version": {
          "const": "review-execution-receipt/v1"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^REVIEW-RECEIPT:[0-9a-f]{64}$"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^REVIEW-LAUNCH:[0-9a-f]{64}$"
        },
        "issuer_role": {
          "const": "HOST_REVIEW_AUTHORITY"
        },
        "issuer_key_id": {
          "type": "string",
          "pattern": "^key:ed25519:[0-9a-f]{64}$"
        },
        "review_role": {
          "enum": [
            "IMPLEMENTATION_READINESS_REVIEWER",
            "CYBERSECURITY_REVIEWER",
            "AGGREGATE_REVIEWER"
          ]
        },
        "review_run_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "workspace_attestation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_content_roots": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commands_executed_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowed_changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unexpected_changed_paths": {
          "type": "array",
          "maxItems": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorization_consumed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fresh_session_attestation": {
          "$ref": "#/$defs/FreshSessionAttestation"
        },
        "production_authority": {
          "const": "NONE"
        },
        "signature_algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "host_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "trust_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "preparation_commands_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
