{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:migrationreceipt",
  "$defs": {
    "MigrationReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "source_identity",
        "destination_root",
        "rebinding_registry_sha256",
        "vendor_root",
        "command_registry_root",
        "legacy_scan_result",
        "content_hash"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "destination_root": {
          "type": "string",
          "minLength": 1
        },
        "rebinding_registry_sha256": {
          "type": "string",
          "minLength": 1
        },
        "vendor_root": {
          "type": "string",
          "minLength": 1
        },
        "command_registry_root": {
          "type": "string",
          "minLength": 1
        },
        "legacy_scan_result": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "FinalMigrationReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "source_identity",
        "destination_root",
        "rebinding_registry_sha256",
        "vendor_root",
        "command_registry_root",
        "legacy_scan_result",
        "content_hash",
        "checked_outputs",
        "authorized_production_phases"
      ],
      "properties": {
        "schema_version": {
          "const": "final-migration-receipt/v1"
        },
        "source_identity": {
          "type": "string",
          "minLength": 1
        },
        "destination_root": {
          "type": "string",
          "minLength": 1
        },
        "rebinding_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vendor_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "command_registry_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "legacy_scan_result": {
          "const": "PASS"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checked_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "basis",
              "owner_task",
              "evidence_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "basis": {
                "enum": [
                  "PINNED_REBOUND",
                  "MAPPED_CONFIG",
                  "IMMUTABLE_FIXTURE",
                  "ACCEPTED_MODIFIER",
                  "NATIVE_LOCK_RECEIPT"
                ]
              },
              "owner_task": {
                "type": "string",
                "pattern": "^V636-"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "authorized_production_phases": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    }
  }
}
