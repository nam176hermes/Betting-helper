{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:command-registry",
  "$defs": {
    "CommandRegistry": {
      "type": "object",
      "required": [
        "schema_version",
        "commands"
      ],
      "properties": {
        "schema_version": {
          "const": "command-registry/v1"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command_id",
              "cwd",
              "argv",
              "purpose",
              "expected_exit",
              "available_at",
              "network",
              "authenticated_operator_access",
              "provider_access",
              "kind"
            ],
            "properties": {
              "command_id": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!.*(?:\\bTODO\\b|\\bTBD\\b|\\bFIXME\\b|\\bPLACEHOLDER\\b|\\.\\.\\.|<[^>]+>|\\$\\{|\\$\\(|`))[\\s\\S]+$"
                }
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "expected_exit": {
                "type": "integer"
              },
              "available_at": {
                "enum": [
                  "DECLARED",
                  "MATERIALIZED",
                  "EXECUTABLE",
                  "QUALIFIED",
                  "SEALED"
                ]
              },
              "network": {
                "const": "DENY"
              },
              "authenticated_operator_access": {
                "const": "DENY"
              },
              "provider_access": {
                "const": "DENY"
              },
              "kind": {
                "enum": [
                  "verification",
                  "operation",
                  "migration",
                  "bootstrap",
                  "plan-check",
                  "review-operation",
                  "review-leaf",
                  "crash-child",
                  "external-bootstrap"
                ]
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "command_id": {
                      "const": "BOOT0_EXTRACT_PLAN"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "argv": {
                      "type": "array",
                      "minItems": 10,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
