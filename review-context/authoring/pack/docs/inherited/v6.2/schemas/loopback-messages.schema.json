        "discovery_run_id",
        "extension_id",
        "pairing_secret_commitment",
        "client_nonce"
      ],
      "properties": {
        "discovery_run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "extension_id": {
          "const": "anfddcancelbmpogbmckmjckjlnpmpjk"
        },
        "pairing_secret_commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "client_nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "PAIR_PROOF_V1": {
