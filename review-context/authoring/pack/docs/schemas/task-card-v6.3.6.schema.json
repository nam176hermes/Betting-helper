{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hybrid-discovery:v6.3.6:task-card",
  "$ref": "#/$defs/TaskManifestV636",
  "$defs": {
    "TaskCardV636": {
      "type": "object",
      "required": [
        "task_id",
        "title",
        "phase",
        "objective",
        "findings",
        "authority",
        "lifecycle_from",
        "lifecycle_to",
        "preconditions",
        "inputs",
        "outputs",
        "exact_files",
        "exact_symbols",
        "exact_schema_refs",
        "exact_command_ids",
        "tests_first",
        "positive_vectors",
        "negative_vectors",
        "implementation_steps",
        "acceptance_criteria",
        "failure_states",
        "evidence_artifacts",
        "rollback",
        "out_of_scope",
        "dependencies",
        "commit_message",
        "stop_condition",
        "status"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^V636-(?:BOOT0|P[0-9]{2}|MIG0)-T[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
        },
        "phase": {
          "enum": [
            "BOOT0",
            "P00",
            "MIG0",
            "P01",
            "P02",
            "P03",
            "P04",
            "P05",
            "P06",
            "P07",
            "P08",
            "P09",
            "P10"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "authority": {
          "enum": [
            "PLAN_AUTHORING",
            "DISCOVERY_IMPLEMENTATION",
            "REVIEW_TOOLING",
            "EXTERNAL_REVIEW"
          ]
        },
        "lifecycle_from": {
          "enum": [
            "DECLARED",
            "MATERIALIZED",
            "EXECUTABLE",
            "QUALIFIED",
            "SEALED",
            "EXTERNAL_REVIEWED"
          ]
        },
        "lifecycle_to": {
          "enum": [
            "DECLARED",
            "MATERIALIZED",
            "EXECUTABLE",
            "QUALIFIED",
            "SEALED",
            "EXTERNAL_REVIEWED"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "exact_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "exact_symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exact_schema_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "exact_command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tests_first": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 0,
          "uniqueItems": false
        },
        "positive_vectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "negative_vectors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "implementation_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "failure_states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "rollback": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "commit_message": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:<[^>]+>|TODO|TBD|FIXME)).+$"
        },
        "status": {
          "const": "NOT_STARTED"
        }
      },
      "additionalProperties": false
    },
    "TaskManifestV636": {
      "type": "object",
      "required": [
        "schema_version",
        "authority",
        "authorized_production_phases",
        "declared_task_count",
        "phase_order",
        "tasks"
      ],
      "properties": {
        "schema_version": {
          "const": "hybrid-discovery-task-manifest/v6.3.6"
        },
        "authority": {
          "const": "PLAN_ONLY"
        },
        "authorized_production_phases": {
          "const": "NONE"
        },
        "declared_task_count": {
          "const": 62
        },
        "phase_order": {
          "type": "array",
          "prefixItems": [
            {
              "const": "BOOT0"
            },
            {
              "const": "P00"
            },
            {
              "const": "MIG0"
            },
            {
              "const": "P01"
            },
            {
              "const": "P02"
            },
            {
              "const": "P03"
            },
            {
              "const": "P04"
            },
            {
              "const": "P05"
            },
            {
              "const": "P06"
            },
            {
              "const": "P07"
            },
            {
              "const": "P08"
            },
            {
              "const": "P09"
            },
            {
              "const": "P10"
            }
          ],
          "items": false,
          "minItems": 13
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TaskCardV636"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
