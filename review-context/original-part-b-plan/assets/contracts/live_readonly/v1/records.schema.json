            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            "sequence": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "observation_id": {
              "type": "string",
              "format": "uuid"
            },
            "observed_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "received_mono_us": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload_type": {
              "const": "MarketBook"
            },
            "payload": {
              "$ref": "#/$defs/MarketBook"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "run_id",
            "source_kind",
            "stream_id",
            "generation",
            "sequence",
            "observation_id",
            "observed_at_utc",
            "received_mono_us",
            "previous_hash",
            "content_hash",
            "payload_type",
            "payload"
          ],
          "properties": {
            "protocol": {
              "const": "BH_LIVE_READONLY_V1"
            },
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_kind": {
              "const": "CONTROL"
            },
            "stream_id": {
              "type": "string",
              "format": "uuid"
            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            "sequence": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 19
            },
            "observation_id": {
              "type": "string",
              "format": "uuid"
            },
            "observed_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "received_mono_us": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
