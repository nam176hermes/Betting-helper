        "session_id",
        "direction",
        "counter",
        "message_type",
        "body",
        "mac"
      ],
      "properties": {
        "protocol": {
          "const": "BH_LIVE_WIRE_V1"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "direction": {
          "enum": [
            "CLIENT_TO_BACKEND",
            "BACKEND_TO_CLIENT"
          ]
        },
        "counter": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 19
        },
        "message_type": {
          "const": "PROJECTION"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "binding",
            "provider_state",
            "books",
            "revision",
            "health",
            "model_status",
            "money_ready"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "format": "uuid"
            },
            "binding": {
              "$ref": "urn:betting-helper:live-records:v1#/$defs/FixtureBinding"
            },
            "provider_state": {
              "anyOf": [
                {
                  "$ref": "urn:betting-helper:live-records:v1#/$defs/ProviderState"
                },
                {
                  "type": "null"
                }
              ]
            },
            "books": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "urn:betting-helper:live-records:v1#/$defs/MarketBook"
              }
            },
            "revision": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 19
            },
            "health": {
              "$ref": "urn:betting-helper:live-records:v1#/$defs/HealthChange"
            },
            "model_status": {
              "const": "MODEL_NOT_QUALIFIED"
            },
            "money_ready": {
              "const": false
            }
          }
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
